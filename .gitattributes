# LF everywhere
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert
*.xlsx    binary
*.xls     binary
*.parquet binary
*.duckdb  binary
*.png     binary
*.jpg     binary
*.pdf     binary

# Secret files: never touch their bytes
secrets/** -text

