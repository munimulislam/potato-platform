APP_ENV=prod
COMPOSE_PROJECT_NAME=potato-prod
COMPOSE_PROFILES=localdb

REGISTRY=potato #<your-registry>.azurecr.io
IMAGE_TAG=0.1.0

POSTGRES_USER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=potato
DB_SSLMODE=prefer

DLT_USER=dlt
DBT_USER=dbt
DAGSTER_USER=dg
AGENT_USER=agent_ro
APP_USER=app
APP_OWNER_USER=app_owner

MLFLOW_VERSION=3.18.0                  # exactly the mlflow / mlflow-skinny version in uv.lock
MLFLOW_USER=mlflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_HTTP_REQUEST_MAX_RETRIES=2
MLFLOW_HTTP_REQUEST_TIMEOUT=30
HOST_MLFLOW_PORT=5000
MODEL_ALIAS=champion

COOKIE_SECURE=false
AUTH_PASSWORD_ENABLED=true
MS_CLIENT_ID=   
MS_TENANT= 
ALLOWED_EMAILS= 

LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama
LLM_BASE_URL=http://ollama:11434/v1
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=1
LLM_NO_THINK=false
AGENT_MAX_CONCURRENT=1
OLLAMA_VERSION=0.40.18
LLM_CONTEXT_LENGTH=8192

MODEL_NAME_OA=oa_xgb_prod