APP_ENV=prod
COMPOSE_PROJECT_NAME=potato-prod
COMPOSE_PROFILES=localdb

REGISTRY=potato #<your-registry>.azurecr.io
IMAGE_TAG=0.1.0

POSTGRES_USER=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=potato
DB_SSLMODE=prefer

DLT_USER=dlt
DBT_USER=dbt
DAGSTER_USER=dg
AGENT_USER=agent_ro
APP_USER=app
APP_OWNER_USER=app_owner

LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama
LLM_BASE_URL=http://ollama:11434/v1
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=1
