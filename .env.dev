APP_ENV=dev                       
COMPOSE_PROJECT_NAME=potato-dev     
COMPOSE_PROFILES=localdb

REGISTRY=potato
IMAGE_TAG=dev

DB_HOST=postgres
DB_PORT=5432
DB_NAME=potato_dev

MLFLOW_VERSION=3.18.0                  # exactly the mlflow / mlflow-skinny version in uv.lock
MLFLOW_USER=mlflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_HTTP_REQUEST_MAX_RETRIES=2
MLFLOW_HTTP_REQUEST_TIMEOUT=30
HOST_MLFLOW_PORT=5000
MODEL_ALIAS=champion

COOKIE_SECURE=false
AUTH_PASSWORD_ENABLED=true
MS_CLIENT_ID=   
MS_TENANT= 
ALLOWED_EMAILS= 

POSTGRES_USER=postgres
DLT_USER=dlt
DBT_USER=dbt
DAGSTER_USER=dg
AGENT_USER=agent_ro
APP_USER=app
APP_OWNER_USER=app_owner

LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_TIMEOUT_SECONDS=600
LLM_MAX_RETRIES=0
